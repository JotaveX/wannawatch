# Modelo do /opt/wannawatch/.env da VPS (chmod 600). Só os segredos: o resto está no compose.yml.

# Senha do Postgres (openssl rand -hex 24)
DB_PASSWORD=
# Token do header X-Admin-Token (POST /api/admin/import e a busca diária de vídeos do GitHub
# Actions, que precisa do mesmo valor no segredo ADMIN_TOKEN do repositório). Vazio = desligado.
ADMIN_TOKEN=
# Token do tunnel wannawatch-vps (Cloudflare Zero Trust → Networks → Tunnels)
TUNNEL_TOKEN=

TMDB_API_TOKEN=
YOUTUBE_API_KEY=
RESEND_API_KEY=
MAIL_FROM=wannawatch? <nao-responda@jotave.dev>

# Bucket "wannawatch" no R2, público em https://r2wannawatch.jotave.dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
