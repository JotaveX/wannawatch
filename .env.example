# Copie para .env (que não vai pro git) e preencha.

# Banco (usado pelo docker-compose e pelo back-end)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=wannawatch
DB_USER=wannawatch
DB_PASSWORD=wannawatch

# Back-end
BACKEND_PORT=8081
# Token do endpoint de admin (POST /api/admin/import, header X-Admin-Token). Vazio = desligado.
ADMIN_TOKEN=
# Origens liberadas no CORS (separe com vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# E-mail (código de confirmação do cadastro). Com RESEND_API_KEY preenchida, o envio é pelo
# Resend (https://resend.com/api-keys) e MAIL_FROM precisa ser de um domínio verificado lá.
# Sem ela, vai por SMTP: o padrão é o Mailpit do docker-compose (e-mails em http://localhost:8025).
RESEND_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=wannawatch? <nao-responda@wannawatch.local>

# TMDB: "API Read Access Token" em https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# YouTube Data API v3 (busca dos vídeos do Reels): https://console.cloud.google.com/apis/credentials
# Vazia = busca desligada. Cota padrão: 100 buscas por dia.
YOUTUBE_API_KEY=
